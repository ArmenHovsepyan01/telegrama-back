<!DOCTYPE html>
<html lang="en">
<head>
    <title>Welcome</title>
</head>
<body>
    <h1>Hello, <%= name %>!</h1>
    <p>Thank you for joining us. We're glad to have you onboard.</p>
    <p>Your registered email is: <%= email %></p>
    <p>Please click the below button to verify your email.</p>
    <br />
    <a href="<%= verificationURL %>" style="text-decoration: none;">
        <button>Verify account</button>
    </a>
</body>
</html>
